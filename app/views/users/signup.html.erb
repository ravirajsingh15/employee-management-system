<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
  <div class="row w-100 shadow-lg rounded-4 overflow-hidden bg-white" style="max-width:1100px; min-width:320px;">

    <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-center p-5 bg-soft">
      <h2 class="fw-bold mb-3">Welcome to Employee Track</h2>
      <p class="text-muted mb-4 fs-5">
        Smart employee tracking & workforce management platform
        designed to boost productivity.
      </p>
      <img src="https://illustrations.popsy.co/gray/work-from-home.svg"
           class="img-fluid"
           alt="Employee Track Illustration">
    </div>

    <div class="col-12 col-lg-6 p-4 p-lg-5 d-flex flex-column justify-content-center">
      <h3 class="fw-bold mb-4 text-center text-lg-start">Let’s get started</h3>

      <%= form_with model: @user, url: signup_path, local: true, html: { autocomplete: "off" } do |f| %>

        <div class="mb-3 position-relative input-wrapper">
          <label class="form-label fw-semibold">Name</label>
          <span class="input-icon">👤</span>
          <%= f.text_field :name,
                class: "form-control ps-5 input-custom",
                placeholder: "Enter Your Name",
                autocomplete: "off",
                required: true %>
        </div>

        <div class="mb-3 position-relative input-wrapper">
          <label class="form-label fw-semibold">Email</label>
          <span class="input-icon">✉️</span>
          <%= f.email_field :email,
                class: "form-control ps-5 input-custom",
                placeholder: "Enter your working email",
                autocomplete: "off",
                required: true %>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Mobile Number</label>
          <div class="d-flex flex-column flex-md-row gap-2 position-relative input-wrapper">
            <%= select_tag "user[country_iso]",
              options_for_select(
                ISO3166::Country.all.sort_by { |c| c.translations['en'] || c.alpha2 }.map do |c|
                  country_name = c.translations['en'] || c.alpha2
                  dial_code = c.country_code.is_a?(Array) ? c.country_code.first : c.country_code
                  ["#{c.emoji_flag || ''} #{country_name} (+#{dial_code})", c.alpha2]
                end,
                "IN"
              ),
              class: "form-select flex-fill input-custom-select"
            %>

            <%= f.telephone_field :phone_no,
                  class: "form-control flex-fill ps-5 input-custom",
                  placeholder: "Enter Mobile Number",
                  required: true,
                  minlength: 10,
                  autocomplete: "off", 
                  maxlength: 15 %>
          </div>
        </div>

        <div class="mb-4 position-relative input-wrapper">
          <label class="form-label fw-semibold">Password</label>
          <span class="input-icon">🔒</span>
          <%= f.password_field :password,
                id: "password",
                class: "form-control ps-5 input-custom",
                placeholder: "Enter your password",
                autocomplete: "new-password",  
                required: true %>

          <span class="password-toggle" onclick="togglePassword('password')">
            👁
          </span>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 btn-shadow">
          Signup →
        </button>

      <% end %>
    </div>
  </div>
</div>

<style>
  .bg-soft {
    background: linear-gradient(135deg, #eef4ff, #f8fbff);
  }

  .input-wrapper {
    position: relative;
  }

  .input-custom {
    height: 45px;
    border-radius: 12px;
    border: 1px solid #ddd;
    transition: all 0.3s;
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.05);
  }

  .input-custom:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.3);
  }

  .input-custom-select {
    border-radius: 12px;
    height: 45px;
    /* width: 80%; */
    border: 1px solid #ddd;
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.05);
  }

  .input-icon, .input-icon-phone {
    position: absolute;
    left: 15px;
    top: 70%;
    transform: translateY(-50%);
    opacity: 0.6;
    pointer-events: none;
  }

  .ps-5 {
    padding-left: 2.5rem !important;
  }

  .password-toggle {
    position: absolute;
    right: 15px;
    top: 70%;
    transform: translateY(-50%);
    cursor: pointer;
    opacity: 0.6;
  }
  .password-toggle:hover {
    opacity: 1;
  }

  .btn-shadow {
    border-radius: 12px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    transition: all 0.3s;
  }
  .btn-shadow:hover {
    box-shadow: 0 6px 12px rgba(0,0,0,0.15);
  }

  @media (max-width: 767px) {
    .d-flex.flex-md-row {
      flex-direction: column !important;
    }
    .input-icon-phone {
      left: 15px;
      margin-bottom: 0.5rem;
    }
  }
</style>

<script>
  window.addEventListener("load", function () {
    const form = document.querySelector("form");
    if (!form) return;

    // 1️⃣ Clear inputs (browser autofill fix)
    form.querySelectorAll("input").forEach(input => {
      if (
        input.type !== "hidden" &&
        input.type !== "submit" &&
        input.type !== "button"
      ) {
        input.value = "";
      }
    });

    // 2️⃣ Force country = India 🇮🇳
    const countrySelect = form.querySelector(
      "select[name='user[country_iso]']"
    );
    if (countrySelect) {
      countrySelect.value = "IN";
    }
  });

  function togglePassword(id) {
    const field = document.getElementById(id);
    field.type = field.type === "password" ? "text" : "password";
  }
</script>


