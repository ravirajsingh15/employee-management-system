<!DOCTYPE html>
<html>
<head>
  <title>Employee Tracker</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <!-- Bootstrap & Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
/* ===== FOOTER ===== */
.footer {
  background: #ffffff;
  border-top: 1px solid #e5e7eb;
  padding: 70px 15px 35px;
  margin-top: 80px;
}

/* DARK MODE */
@media (prefers-color-scheme: dark) {
  .footer { background:#020617; border-color:#1e293b; }
  .footer * { color:#cbd5f5 !important; }
  .trust-card { background:#020617; border-color:#1e293b; }
  .newsletter input { background:#020617; border-color:#334155; color:#e5e7eb; }
}

/* Rating */
.footer-rating {
  text-align:center;
  font-weight:800;
}
.footer-rating i { color:#facc15; }

/* Trust cards */
.trust-wrap {
  display:flex;
  justify-content:center;
  flex-wrap:wrap;
  gap:20px;
  margin:35px 0;
}

.trust-card {
  background:#f8fafc;
  border:1px solid #e5e7eb;
  border-radius:18px;
  padding:18px 22px;
  display:flex;
  align-items:center;
  gap:14px;
  box-shadow:0 12px 30px rgba(0,0,0,.06);
}

.trust-card img {
  height:40px;
  object-fit:contain;
}

/* Newsletter */
.newsletter {
  max-width:520px;
  margin:40px auto;
  text-align:center;
}
.newsletter input {
  border-radius:14px;
  padding:12px;
  border:1px solid #e5e7eb;
}
.newsletter button {
  border-radius:14px;
  font-weight:700;
  background:linear-gradient(135deg,#2563eb,#60a5fa);
  color:#fff;
  border:none;
}

/* Social */
.footer-social {
  display:flex;
  justify-content:center;
  gap:16px;
  margin:35px 0;
}
.footer-social a {
  width:42px;
  height:42px;
  border-radius:14px;
  background:#f1f5f9;
  display:flex;
  align-items:center;
  justify-content:center;
}
.footer-social a:hover {
  background:linear-gradient(135deg,#2563eb,#60a5fa);
  color:#fff;
  transform:translateY(-3px);
}

.footer-bottom {
  text-align:center;
  font-size:.8rem;
  color:#64748b;
}
    :root {
      --primary: #2563eb;
      --success: #22c55e;
      --warning: #f97316;
      --dark: #0f172a;
      --muted: #64748b;
    }

    body {
      font-family: 'Inter', sans-serif;
      background: linear-gradient(180deg, #f8fafc, #eef2ff);
      color: var(--dark);
    }

    a { text-decoration: none; }

    /* ===== NAVBAR ===== */
    .navbar {
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      padding: 0.9rem 2rem;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    .brand {
      font-weight: 800;
      font-size: 1.4rem;
      display: flex;
      align-items: center;
      gap: 10px;
      color: var(--primary);
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 14px;
      background: linear-gradient(135deg, #2563eb, #60a5fa);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 800;
    }

    .nav-link {
      color: black !important;
      font-weight: 500;
      padding: 8px 16px;
      border-radius: 10px;
      transition: all 0.25s ease;
    }

    .nav-link:hover {
      background: #eff6ff;
      color: var(--primary) !important;
    }

    /* Pricing Highlight */
    .pricing-link:hover {
      background: linear-gradient(135deg, #aa22c5d0, #aa22c5d0 );
      color: #ffffff !important;
      box-shadow: 0 8px 20px rgba(34,197,94,0.4);
    }

     .price-link:hover {
      background: linear-gradient(135deg, #22c55e, #16a34a);
      color: #ffffff !important;
      box-shadow: 0 8px 20px rgba(34,197,94,0.4);
    }

    /* Book Demo */
    .btn-demo {
      border: 2px solid var(--primary);
      background: transparent;
      color: var(--primary);
      border-radius: 14px;
      font-weight: 600;
      padding: 6px 18px;
      transition: all 0.25s ease;
    }

    .btn-demo:hover {
      background: linear-gradient(135deg, #2563eb, #60a5fa);
      color: white;
      box-shadow: 0 8px 22px rgba(37,99,235,0.45);
      transform: translateY(-1px);
    }

    /* Free Trial CTA */
    .btn-trial {
      background: linear-gradient(135deg, #f97316, #fb923c);
      color: white;
      border-radius: 16px;
      font-weight: 700;
      padding: 8px 24px;
      box-shadow: 0 12px 30px rgba(249,115,22,0.5);
      transition: all 0.25s ease;
    }

    .btn-trial:hover {
      background: linear-gradient(135deg, #ea580c, #f97316);
      box-shadow: 0 18px 40px rgba(249,115,22,0.65);
      transform: translateY(-2px);
    }

    /* ===== PAGE ===== */
    .page {
      padding: 45px 15px;
      max-width: 1200px;
      margin: auto;
    }

    /* ===== STATS ===== */
    .stat-card {
      background: white;
      border-radius: 18px;
      padding: 26px;
      text-align: center;
      box-shadow: 0 12px 35px rgba(0,0,0,.06);
      transition: all 0.3s ease;
    }

    .stat-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 55px rgba(0,0,0,.12);
    }

    .stat-title {
      font-size: 0.85rem;
      color: var(--muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .stat-value {
      font-size: 2rem;
      font-weight: 800;
      margin-top: 10px;
      background: linear-gradient(135deg, #2563eb, #22c55e);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    /* ===== TABLE ===== */
    .table-card {
      background: white;
      border-radius: 18px;
      padding: 28px;
      box-shadow: 0 15px 40px rgba(0,0,0,.08);
      margin-top: 30px;
    }

    .table thead {
      background: #f1f5f9;
    }

    .table th {
      font-size: 0.8rem;
      text-transform: uppercase;
      color: white;
    }

    .table tbody tr:hover {
      background: #eff6ff;
    }

    /* ===== FOOTER ===== */
    footer {
      text-align: center;
      font-size: 0.85rem;
      color: var(--muted);
      padding: 30px 0;
    }

    @media (max-width: 768px) {
      .stat-value { font-size: 1.6rem; }
    }
  </style>
</head>

<body>

<!-- ===== NAVBAR ===== -->
<nav class="navbar navbar-expand-lg">
  <div class="container-fluid">
    <div class="brand">
      <div class="brand-icon">ET</div>
      Employee Tracker
    </div>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMenu">
      <ul class="navbar-nav ms-auto gap-2 align-items-center">
        <li><%= link_to "Dashboard", dashboard_path, class: "nav-link" %></li>
        <li><%= link_to "Employees", employees_path, class: "nav-link" %></li>
        <li><%= link_to "Reports", reports_path, class: "nav-link" %></li>
        <li><%= link_to "Activity", daily_activities_path, class: "nav-link" %></li>
        <li><%= link_to "Pricing", pricing_path, class: "nav-link price-link" %></li>
        <li><%= link_to "Book Demo", class: "btn btn-demo btn-sm"%></li>
        <li><%= button_to "Start Free Trial", class: "btn btn-trial btn-sm" %></li>

        <% if logged_in? %>
          <li><%= button_to "Logout", logout_path, method: :delete, class: "btn btn-outline-primary btn-sm" %></li>
        <% else %>
          <li><%= link_to "Login", login_path, class: "btn btn-outline-primary btn-sm" %></li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>

<div class="table-card">
  <%= render "shared/toast" %>
  <%= yield %>
  </div>
</div>

<footer class="app-footer">
  <div class="footer-inner">

    <!-- Brand -->
    <div class="footer-brand">
      <div class="logo">ET</div>
      Employee Tracker
    </div>

    <!-- Text -->
    <div class="footer-text">
      Smart employee monitoring & productivity analytics platform
      <br>
      © <%= Time.current.year %> Employee Tracker
    </div>

    <!-- Social -->
    <div class="footer-social">
      <a href="https://www.linkedin.com/" target="_blank"><i class="bi bi-linkedin"></i></a>
      <a href="https://twitter.com/" target="_blank"><i class="bi bi-twitter-x"></i></a>
      <a href="https://github.com/" target="_blank"><i class="bi bi-github"></i></a>
      <a href="https://www.instagram.com/" target="_blank"><i class="bi bi-instagram"></i></a>
    </div>

  </div>
</footer>

</body>
</html>

<style>
/* ===== HORIZONTAL FOOTER ===== */
.app-footer {
  background: #ffffff;
  border-top: 1px solid #e5e7eb;
  padding: 22px 20px;
  margin-top: 80px;
}

.footer-inner {
  max-width: 1200px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

/* Brand */
.footer-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 800;
  font-size: 1.1rem;
  color: #2563eb;
}

.footer-brand .logo {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: linear-gradient(135deg,#2563eb,#60a5fa);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
}

/* Text */
.footer-text {
  font-size: 0.85rem;
  color: #64748b;
  text-align: center;
}

/* Social */
.footer-social {
  display: flex;
  gap: 12px;
}

.footer-social a {
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #334155;
  transition: all 0.25s ease;
}

.footer-social a:hover {
  background: linear-gradient(135deg,#2563eb,#60a5fa);
  color: #fff;
  transform: translateY(-3px);
}

/* DARK MODE */
@media (prefers-color-scheme: dark) {
  .app-footer {
    background: #020617;
    border-color: #1e293b;
  }

  .footer-text { color: #94a3b8; }
  .footer-social a { background: #020617; border: 1px solid #1e293b; color:#cbd5f5; }
}
</style>
