<!DOCTYPE html>
<html>
  <head>
    <title>Employee Tracer System</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module", defer: true %>
    
    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
    <%= render "shared/delete_modal" %>
    
    <style>
      body {
        overflow: hidden; /* full page scroll band */
      }

      .layout {
        display: flex;
        height: 100vh;
      }

      .sidebar {
        width: 220px;
        background-color: #212529;
        color: #fff;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        overflow: hidden; /* sidebar scroll band */
      }

      .content {
        margin-left: 220px;
        width: calc(100% - 220px);
        height: 100vh;
        overflow-y: auto; /* ✅ sirf yaha scroll */
        padding: 1.5rem;
        background: #f8f9fa;
      }

      .fileupload{
        font-size: 20px;
      }
    </style>
  </head>

  <div class="toast-container position-fixed top-0 end-0 p-3">
  <% flash.each do |type, message| %>
    <div class="toast show bg-danger border-0"
         data-bs-autohide="true"
         data-bs-delay="3000">
      <div class="d-flex">
        <div class="toast-body">
          <%= message %>
        </div>
        <button type="button"
                class="btn-close btn-close-white me-2 m-auto"
                data-bs-dismiss="toast">
        </button>
      </div>
    </div>
  <% end %>
</div>

  <body>
    <div class="layout">

      <!-- Sidebar -->
      <div class="sidebar p-3">
        <h4 class="text-center">Employee Tracer System</h4>
        <hr class="bg-light">

        <ul class="nav flex-column">
          <li class="nav-item mb-2">
            <%= link_to dashboard_path, class:"nav-link text-white" do %>
              <i class="bi bi-house-door-fill me-2"></i> Dashboard
            <% end %>
          </li>

          <li class="nav-item mb-2">
            <%= link_to employees_path, class:"nav-link text-white" do %>
              <i class="bi bi-person-plus-fill me-2"></i> Employee Details
            <% end %>
          </li>

           <li class="nav-item mb-2">
            <%= link_to reports_path, class:"nav-link text-white" do %>
              <i class="bi bi-bar-chart-fill me-2"></i> Reports
            <% end %>
          </li>


          <li class="nav-item mb-2">
            <%= link_to daily_activities_path, class:"nav-link text-white" do %>
              <i class="bi bi-calendar-event-fill me-2"></i> Daily Activity
              <% end %>
          </li>

          <li class="nav-item mb-2">
            <%= link_to resume_path, class:"nav-link text-white" do %>
              <i class="bi bi-file-earmark-arrow-up-fill fileupload"></i> File Upload
            <% end %>
          </li>

          <li class="nav-item mt-4">
            <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-danger w-100" %>
          </li>
        </ul>
      </div>

      <!-- Main Content -->
      <div class="content">
        <%= yield %>
      </div>

    </div>
  </body>
</html>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll('.toast').forEach(function (toastEl) {
      new bootstrap.Toast(toastEl, {
        autohide: true,
        delay: 3000 // 3 seconds
      }).show();
    });
  });
</script>
