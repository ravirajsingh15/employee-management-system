<!DOCTYPE html>
<html>
<head>
  <title>Pricing</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <style>
    body { background:#f8fafc; }

    /* ===== CHECK ICON (IMAGE STYLE) ===== */
    .dt-check{
      width:22px;height:22px;border-radius:50%;
      border:2px solid #2563eb;background:#fff;
      display:inline-flex;align-items:center;justify-content:center;
      flex-shrink:0;
    }
    .dt-check::after{
      content:"✓";color:#2563eb;font-size:14px;font-weight:700;
    }

    /* ===== TOGGLE ===== */
    .pricing-toggle{
      background:#e5e7eb;padding:6px;border-radius:999px;
      display:inline-flex;gap:6px;
    }
    .pricing-toggle span{
      padding:10px 24px;border-radius:999px;
      font-weight:600;cursor:pointer;
    }
    .pricing-toggle span.active{
      background:#2563eb;color:#fff;
      box-shadow:0 6px 18px rgba(37,99,235,.4);
    }

    /* ===== PRICE CARD ===== */
    .price-card{
      background:#fff;padding:36px;border-radius:22px;
      box-shadow:0 18px 45px rgba(0,0,0,.08);
      transition:.3s;position:relative;height:100%;
    }
    .price-card:hover{
      transform:translateY(-8px);
      box-shadow:0 30px 70px rgba(0,0,0,.12);
    }
    .featured{
      border:2px solid #2563eb;
      background:linear-gradient(180deg,#f8fafc,#eef2ff);
    }
    .badge{
      position:absolute;top:-14px;left:50%;
      transform:translateX(-50%);
      background:#2563eb;color:#fff;
      padding:6px 16px;border-radius:999px;font-size:12px;
    }

    .price{font-size:2.6rem;font-weight:800;margin:20px 0 10px;}
    .price span{font-size:1rem;color:#6b7280;}

    .price-card ul{list-style:none;padding:0;margin-top:24px;}
    .price-card ul li{
      display:flex;align-items:center;gap:12px;padding:8px 0;
    }

    /* ===== COMPARE ===== */
    .compare-card{
      background:#fff;border-radius:20px;padding:28px;
      box-shadow:0 16px 40px rgba(0,0,0,.08);
      text-align:center;height:100%;
    }
    .feature-list{
      text-align:left;background:#f8fafc;
      font-weight:500;
    }
    .compare-card ul{list-style:none;padding:0;}
    .compare-card ul li{
      padding:12px 0;border-bottom:1px dashed #e5e7eb;
    }
  </style>
</head>

<body>

<div class="container py-5">

  <!-- HERO -->
  <section class="text-center mb-5">
  <span class="badge bg-dark-subtle text-dark px-3 py-2 mb-3">
    Flexible & Transparent Pricing
  </span>

  <h1 class="fw-bold display-5 mb-3">
    Pricing designed for <span class="text-primary">growing teams</span>
  </h1>

  <p class="text-muted fs-5 mx-auto" style="max-width: 640px;">
    Pay only for what you use with clear, upfront pricing.  
    No hidden fees, no long-term commitments — cancel anytime.
  </p>
</section>


  <!-- TOGGLES -->
  <div class="d-flex justify-content-center gap-3 mb-5">
    <div class="pricing-toggle" id="billingToggle">
      <span class="active" data-type="monthly">Monthly</span>
      <span data-type="annual">Annual (Save 20%)</span>
    </div>
    <div class="pricing-toggle" id="currencyToggle">
      <span class="active" data-currency="INR">₹ INR</span>
      <span data-currency="USD">$ USD</span>
    </div>
  </div>

  <!-- PRICING -->
  <div class="row g-4 justify-content-center">

    <div class="col-md-4">
      <div class="price-card">
        <h5>Starter</h5>
        <h2 class="price"
          data-inr-monthly="99" data-inr-annual="79"
          data-usd-monthly="2" data-usd-annual="1.6">
          ₹99 <span>/mo</span>
        </h2>
        <p class="text-muted">For small teams</p>
        <ul>
          <li><span class="dt-check"></span>Up to 10 employees</li>
          <li><span class="dt-check"></span>Attendance</li>
          <li><span class="dt-check"></span>Email support</li>
        </ul>
        <a class="btn btn-outline-primary w-100 mt-3">Start Free Trial</a>
      </div>
    </div>

    <div class="col-md-4">
      <div class="price-card featured">
        <div class="badge">Most Popular</div>
        <h5>Professional</h5>
        <h2 class="price"
          data-inr-monthly="499" data-inr-annual="399"
          data-usd-monthly="8" data-usd-annual="6.4">
          ₹499 <span>/mo</span>
        </h2>
        <p class="text-muted">Growing companies</p>
        <ul>
          <li><span class="dt-check"></span>Unlimited employees</li>
          <li><span class="dt-check"></span>Reports & analytics</li>
          <li><span class="dt-check"></span>Document uploads</li>
          <li><span class="dt-check"></span>Priority support</li>
          <li><span class="dt-check"></span>Large organizations</li>
        </ul>
        <a class="btn btn-primary w-100 mt-3">Get Started</a>
      </div>
    </div>

    <div class="col-md-4">
      <div class="price-card">
        <h5>Enterprise</h5>
        <h2 class="price">Custom</h2>
        <p class="text-muted">Large organizations</p>
        <ul>
          <li><span class="dt-check"></span>Custom integrations</li>
          <li><span class="dt-check"></span>Dedicated manager</li>
          <li><span class="dt-check"></span>SLA support</li>
        </ul>
        <a class="btn btn-outline-primary w-100 mt-3">Contact Sales</a>
      </div>
    </div>

  </div>

  <!-- ===== COMPARE PLANS ===== -->
  <div class="mt-5">
    <h3 class="fw-bold text-center mb-4">Compare Plans</h3>

    <div class="row g-4">

      <div class="col-md-3">
        <div class="compare-card feature-list">
          <h6>Features</h6>
          <ul>
            <li>Employees</li>
            <li>Attendance</li>
            <li>Export Reports</li>
            <li>Document Uploads</li>
            <li>Email Reports</li>
            <li>Support</li>
            <li>Large organizations</li>
            <li>Custom integrations</li>
            <li>Dedicated manager</li>
            <li>SLA support</li>
          </ul>
        </div>
      </div>

      <div class="col-md-3">
        <div class="compare-card">
          <h6>Starter</h6>
          <ul>
            <li>Up to 10</li>
            <li><span class="dt-check"></span></li>
            <li>—</li>
            <li>—</li>
            <li>—</li>
            <li>Email</li>
            <li>—</li>
            <li>—</li>
            <li>—</li>
            <li>—</li>
          </ul>
        </div>
      </div>

      <div class="col-md-3">
        <div class="compare-card featured">
          <h6>Professional</h6>
          <ul>
            <li><strong>Unlimited</strong></li>
            <li><span class="dt-check"></span></li>
            <li><span class="dt-check"></span></li>
            <li><span class="dt-check"></span></li>
            <li><span class="dt-check"></span></li>
            <li><strong>Priority</strong></li>
            <li><span class="dt-check"></span></li>
            <li><strong>Priority</strong></li>
            <li><strong>Priority</strong></li>
            <li><span class="dt-check"></span></li>
          </ul>
        </div>
      </div>

      <div class="col-md-3">
        <div class="compare-card featured">
          <h6>Enterprise</h6>
          <ul>
            <li><strong>Unlimited</strong></li>
            <li><span class="dt-check"></span></li>
            <li><span class="dt-check"></span></li>
            <li><span class="dt-check"></span></li>
            <li><span class="dt-check"></span></li>
            <li><strong>Priority</strong></li>
            <li><span class="dt-check"></span></li>
            <li><span class="dt-check"></span></li>
            <li><span class="dt-check"></span></li>
            <li><span class="dt-check"></span></li>
          </ul>
        </div>
      </div>

    </div>
  </div>

</div>

<script>
let billingType="monthly",currency="INR";
function updatePrices(){
  document.querySelectorAll(".price").forEach(p=>{
    if(!p.dataset.inrMonthly)return;
    const sym=currency==="INR"?"₹":"$";
    const key=`${currency.toLowerCase()}${billingType[0].toUpperCase()+billingType.slice(1)}`;
    p.innerHTML=`${sym}${p.dataset[key]} <span>/mo</span>`;
  });
}
document.querySelectorAll(".pricing-toggle span").forEach(b=>{
  b.onclick=()=>{
    b.parentElement.querySelectorAll("span").forEach(s=>s.classList.remove("active"));
    b.classList.add("active");
    if(b.dataset.type)billingType=b.dataset.type;
    if(b.dataset.currency)currency=b.dataset.currency;
    updatePrices();
  }
});
</script>

</body>
</html>
