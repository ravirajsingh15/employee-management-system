<div class="container-fluid">
  <div class="d-flex justify-content-between mb-3">
    <h2 class="fw-bold">Employee Details</h2>
    <%= link_to "Add New Employee", new_employee_path, class: "btn btn-primary" %>
  </div>

  <div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
      <thead class="table-dark">
        <tr>
          <th>id</th>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Address</th>
          <th>Work Type</th>
          <th>Last Active</th>
          <th>Department</th>
          <th>Designation</th>
          <th>Joining_date</th>
          <th>Salary</th>
          <th>Actions</th>

        </tr>
      </thead>

      <tbody>
        <% @employees.each_with_index do |emp, index| %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= emp.name %></td>
            <td><%= emp.email %></td>
            <td><%= emp.phone %></td>
            <td><%= emp.address %></td>
            <td><%= emp.work_type.titleize %></td>
            <td><%= emp.last_active&.strftime("%d-%m-%Y") %></td>
            <td><%= emp.department %></td>
            <td><%= emp.designation %></td>
            <td><%= emp.joining_date&.strftime("%d-%m-%Y") %></td>
            <td><%= emp.salary %></td>
            <td>
              <%= link_to edit_employee_path(emp),
                    class: "btn btn-sm btn-warning me-1" do %>
                <i class="bi bi-pencil"></i>
              <% end %>

              <%= button_to employee_path(emp),
                    method: :delete,
                    data: { confirm: "Are you sure?" },
                    class: "btn btn-sm btn-danger" do %>
                <i class="bi bi-trash"></i>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>


