<div class="container-fluid mt-4">

  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">Employee Details</h2>
  </div>

  <!-- SEARCH & FILTER -->
  <%= form_with url: employees_path,
              method: :get,
              local: true,
              class: "row g-2 mb-3",
              id: "employeeFilterForm" do %>

  <!-- Search -->
  <div class="col-md-4">
    <%= text_field_tag :q, params[:q],
          class: "form-control",
          placeholder: "Search by name, email, department",
          id: "searchInput" %>
  </div>

  <!-- Work Type -->
  <div class="col-md-3">
    <%= select_tag :work_type,
          options_for_select(
            [["All Work Types", ""], ["WFO", "wfo"], ["WFH", "wfh"], ["No Working", "noworking"]],
            params[:work_type]
          ),
          class: "form-select",
          id: "workTypeSelect" %>
      </div>

      <!-- Reset -->
      <div class="col-md-2">
        <%= link_to employees_path, class: "btn btn-secondary w-100" do %>
          <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
        <% end %>
      </div>

      <!-- Add -->
      <div class="col-md-2">
        <%= link_to new_employee_path, class: "btn btn-primary w-100" do %>
          <i class="bi bi-plus-circle me-1"></i> Add Employee
        <% end %>
      </div>

    <% end %>

  <!-- TABLE -->
  <div class="table-responsive">
    <table class="table table-striped table-bordered align-middle">
      <thead class="table-dark">
        <tr>
          <th>#</th>
          <th>Name</th>
          <th>Email</th>
          <th>Phone</th>
          <th>Work Type</th>
          <th>Department</th>
          <th>Joining Date</th>
          <th>Salary</th>
          <th class="text-center">Actions</th>
        </tr>
      </thead>

      <tbody>
        <% @employees.each_with_index do |emp, index| %>
          <tr>
            <td><%= index + 1 + ((@employees.current_page - 1) * @employees.limit_value) %></td>
            <td><%= emp.name %></td>
            <td><%= emp.email %></td>
            <td><%= emp.phone %></td>
            <td><%= emp.work_type&.titleize %></td>
            <td><%= emp.department %></td>
            <td><%= emp.joining_date&.strftime("%d-%m-%Y") %></td>
            <td><%= emp.salary %></td>
            <td class="text-center">

              <%= link_to edit_employee_path(emp),
                    class: "btn btn-sm btn-warning me-1" do %>
                <i class="bi bi-pencil"></i>
              <% end %>

              <button
                class="btn btn-sm btn-danger"
                data-bs-toggle="modal"
                data-bs-target="#deleteModal"
                data-employee-id="<%= emp.id %>">
                <i class="bi bi-trash"></i>
              </button>

            </td>
          </tr>
        <% end %>

        <% if @employees.empty? %>
          <tr>
            <td colspan="9" class="text-center text-muted">
              No employees found
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- PAGINATION -->
  <div class="d-flex justify-content-center mt-3">
    <%= paginate @employees %>
  </div>

</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title text-danger">Confirm Delete</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        ⚠️ Are you sure you want to delete this employee?
        <br><strong>This action cannot be undone.</strong>
      </div>

      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>

        <form id="deleteEmployeeForm" method="post">
          <input type="hidden" name="_method" value="delete">
          <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </form>
      </div>

    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {

  /* ========= DELETE MODAL ========= */
  const deleteModal = document.getElementById("deleteModal");

  if (deleteModal) {
    deleteModal.addEventListener("show.bs.modal", function (event) {
      const button = event.relatedTarget;
      const employeeId = button.getAttribute("data-employee-id");

      document.getElementById("deleteEmployeeForm").action =
        `/employees/${employeeId}`;
    });
  }

  /* ========= AUTO SEARCH & FILTER ========= */
  const form = document.getElementById("employeeFilterForm");
  const searchInput = document.getElementById("searchInput");
  const workTypeSelect = document.getElementById("workTypeSelect");

  if (!form || !searchInput || !workTypeSelect) return;

  let typingTimer;
  const delay = 400;

  // Auto search while typing
  searchInput.addEventListener("input", function () {
    clearTimeout(typingTimer);
    typingTimer = setTimeout(() => {
      form.requestSubmit();
    }, delay);
  });

  // Auto filter on dropdown change
  workTypeSelect.addEventListener("change", function () {
    form.requestSubmit();
  });

});
</script>

