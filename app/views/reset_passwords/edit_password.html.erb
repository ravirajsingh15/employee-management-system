<div class="reset-password-container">
  <div class="reset-card">
    <h3 class="reset-title">Reset Your Password</h3>

    <%= form_with url: update_password_reset_path, method: :patch, local: true, class: "reset-form" do %>
      <%= hidden_field_tag :token, params[:token] %>

      <div class="form-group password-wrapper">
        <%= password_field_tag :password, nil, placeholder: "New Password", required: true, class: "form-control", id: "password" %>
        <label>New Password</label>
        <span class="password-toggle" onclick="togglePassword('password', this)">
          <i class="fa fa-eye"></i>
        </span>
      </div>

      <div class="form-group password-wrapper">
        <%= password_field_tag :password_confirmation, nil, placeholder: "Confirm Password", required: true, class: "form-control", id: "password_confirmation" %>
        <label>Confirm Password</label>
        <span class="password-toggle" onclick="togglePassword('password_confirmation', this)">
          <i class="fa fa-eye"></i>
        </span>
      </div>

      <div class="form-group">
        <%= submit_tag "Update Password", class: "btn btn-gradient w-100" %>
      </div>
    <% end %>
  </div>
</div>

<!-- ================= CSS ================= -->
<style>
/* Container Centering */
.reset-password-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #e0f7fa, #f1f8e9);
  font-family: 'Montserrat', sans-serif;
  padding: 20px;
}

/* Card */
.reset-card {
  background: #ffffff;
  border-radius: 20px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.1);
  width: 100%;
  max-width: 420px;
  padding: 40px 30px;
  position: relative;
  transition: all 0.3s ease;
}

.reset-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 25px 50px rgba(0,0,0,0.15);
}

/* Title */
.reset-title {
  text-align: center;
  font-weight: 700;
  margin-bottom: 30px;
  font-size: 1.8rem;
  color: #111827;
}

/* Form */
.reset-form .form-group {
  position: relative;
  margin-bottom: 25px;
}

.reset-form label {
  position: absolute;
  top: -8px;
  left: 15px;
  background: #fff;
  padding: 0 5px;
  font-size: 0.9rem;
  color: #6b7280;
  pointer-events: none;
}

/* Input */
.reset-form .form-control {
  width: 100%;
  padding: 15px 45px 15px 15px;
  border-radius: 12px;
  border: 1px solid #d1d5db;
  font-size: 1rem;
  transition: all 0.3s ease;
}

.reset-form .form-control:focus {
  outline: none;
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.2);
}

/* Password toggle */
.password-toggle {
  position: absolute;
  right: 15px;
  top: 50%;
  transform: translateY(-50%);
  cursor: pointer;
  color: #6b7280;
  font-size: 18px;
  transition: all 0.3s ease;
}

.password-toggle:hover {
  transform: translateY(-50%) scale(1.2);
}

/* Gradient button */
.btn-gradient {
  background: linear-gradient(135deg, #4f46e5, #3b82f6);
  color: #fff;
  font-weight: 600;
  padding: 15px;
  border-radius: 12px;
  border: none;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-gradient:hover {
  background: linear-gradient(135deg, #3b82f6, #4f46e5);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
}
</style>

<!-- ================= JS ================= -->
<script>
function togglePassword(fieldId, el) {
  const field = document.getElementById(fieldId);
  const icon = el.querySelector("i");
  if (field.type === "password") {
    field.type = "text";
    icon.classList.replace("fa-eye", "fa-eye-slash");
    el.style.transform = "translateY(-50%) translateX(5px) scale(1.2)";
  } else {
    field.type = "password";
    icon.classList.replace("fa-eye-slash", "fa-eye");
    el.style.transform = "translateY(-50%) translateX(0) scale(1)";
  }
}
</script>
