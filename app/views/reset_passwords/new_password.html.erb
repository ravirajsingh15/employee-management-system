<div class="forgot-password-container">
  <div class="forgot-card">
    <h2 class="forgot-title">Forgot Password</h2>
    <p class="forgot-subtitle">Enter your email to receive a password reset link.</p>

    <%= form_with url: create_password_reset_path, local: true, class: "forgot-form" do %>
      <div class="form-group">
        <%= email_field_tag :email, nil, placeholder: "Your Email", required: true, class: "form-control", id: "email" %>
        <label>Email Address</label>
      </div>

      <div class="form-group">
        <%= submit_tag "Send Reset Link", class: "btn btn-gradient w-100" %>
      </div>
    <% end %>

    <div class="back-login">
      <%= link_to "Back to Login", login_path, class: "back-link" %>
    </div>
  </div>
</div>

<!-- ================= CSS ================= -->
<style>
/* Container Center */
.forgot-password-container {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #fef3c7, #d9f99d);
  font-family: 'Poppins', sans-serif;
  padding: 20px;
}

/* Card */
.forgot-card {
  background: #fff;
  border-radius: 20px;
  max-width: 400px;
  width: 100%;
  padding: 40px 30px;
  box-shadow: 0 25px 50px rgba(0,0,0,0.1);
  transition: all 0.3s ease;
  position: relative;
}

.forgot-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 30px 60px rgba(0,0,0,0.15);
}

/* Title */
.forgot-title {
  text-align: center;
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: #111827;
}

.forgot-subtitle {
  text-align: center;
  font-size: 0.95rem;
  color: #6b7280;
  margin-bottom: 30px;
}

/* Form Group */
.forgot-form .form-group {
  position: relative;
  margin-bottom: 25px;
}

.forgot-form label {
  position: absolute;
  top: -8px;
  left: 15px;
  background: #fff;
  padding: 0 5px;
  font-size: 0.9rem;
  color: #6b7280;
  pointer-events: none;
}

/* Input */
.forgot-form .form-control {
  width: 100%;
  padding: 15px;
  border-radius: 12px;
  border: 1px solid #d1d5db;
  font-size: 1rem;
  transition: all 0.3s ease;
}

.forgot-form .form-control:focus {
  outline: none;
  border-color: #16a34a;
  box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.2);
}

/* Gradient Button */
.btn-gradient {
  background: linear-gradient(135deg, #16a34a, #22c55e);
  color: #fff;
  font-weight: 600;
  padding: 15px;
  border-radius: 12px;
  border: none;
  font-size: 1rem;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-gradient:hover {
  background: linear-gradient(135deg, #22c55e, #16a34a);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
}

/* Back Link */
.back-login {
  text-align: center;
  margin-top: 15px;
}

.back-link {
  color: #16a34a;
  text-decoration: none;
  font-weight: 500;
  transition: all 0.3s ease;
}

.back-link:hover {
  text-decoration: underline;
  color: #15803d;
}
</style>
