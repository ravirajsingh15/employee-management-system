<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center gradient-bg"
     id="themeRoot">

  <div class="card shadow-lg border-0 rounded-4 overflow-hidden login-animate"
       style="max-width:900px; width:100%;">

    <div class="row g-0">

      <!-- 🖼 LEFT -->
      <div class="col-md-6 d-none d-md-flex flex-column align-items-center justify-content-center bg-soft text-center px-4">
        <p class="text-muted mb-4 fs-5">
          Smart employee tracking & workforce management platform
          designed to boost productivity.
        </p>
        <img src="https://illustrations.popsy.co/gray/work-from-home.svg"
             class="img-fluid"
             style="max-height:360px;">
      </div>

      <!-- 📝 FORM -->
      <div class="col-md-6 position-relative">

        <%= link_to "✕", root_path,
              class: "position-absolute top-0 end-0 m-3 text-muted fs-5 text-decoration-none" %>

        <div class="card-body p-4 p-lg-5">
          <h3 class="fw-bold text-center mb-1">Welcome Back 👋</h3>
          <p class="text-muted text-center mb-4">Login to Employee Track</p>

          <%= form_with url: login_path, local: true do %>

            <!-- Email -->
            <div class="form-floating mb-3">
              <%= email_field_tag :email, nil,
                    class: "form-control",
                    placeholder: "Email",
                    required: true %>
              <label>Email address</label>
            </div>

            <!-- Password -->
            <div class="form-floating mb-3 position-relative">
              <%= password_field_tag :password, nil,
                    class: "form-control",
                    placeholder: "Password",
                    required: true,
                    id: "password" %>
              <label>Password</label>
              <span class="password-toggle" onclick="togglePassword('password')">👁</span>
            </div>

            <!-- Confirm Password -->
            <div class="form-floating mb-3 position-relative">
              <%= password_field_tag :password_confirmation, nil,
                    class: "form-control",
                    placeholder: "Confirm Password",
                    required: true,
                    id: "password_confirmation" %>
              <label>Confirm Password</label>
              <span class="password-toggle" onclick="togglePassword('password_confirmation')">👁</span>
            </div>

            <%= link_to "Forgot password?", new_password_reset_path, class: "small fw-semibold text-decoration-none" %>

            <%= submit_tag "Login",
                  class: "btn btn-primary btn-lg w-100 fw-semibold mt-3" %>
          <% end %>

          <p class="text-center mt-4 mb-0">
            New here?
            <%= link_to "Create an account",
                  signup_path,
                  class: "fw-semibold text-decoration-none" %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ================= CSS ================= -->
<style>
  .gradient-bg { background: linear-gradient(135deg, #eef2ff, #f8fafc); }
  .bg-soft { background-color: #f8f9fa; }
  .password-toggle {
    position: absolute;
    top: 50%;
    right: 16px;
    transform: translateY(-50%);
    cursor: pointer;
    user-select: none;
  }
  .login-animate {
    animation: fadeSlide 0.7s ease forwards;
  }
  @keyframes fadeSlide {
    from { opacity: 0; transform: translateY(25px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<!-- ================= JS ================= -->
<script>
  // Generic function to toggle password visibility
  function togglePassword(fieldId) {
    const field = document.getElementById(fieldId);
    if (field.type === "password") {
      field.type = "text";
    } else {
      field.type = "password";
    }
  }
</script>
