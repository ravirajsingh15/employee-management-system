<h3 class="fw-bold mb-4">Mark Daily Activity</h3>

<%= form_with model: @daily_activity, local: true do |f| %>

  <div class="mb-3">
    <label class="fw-semibold">Employee</label>
    <%= f.collection_select :employee_id, @employees, :id, :name,
          { prompt: "Select Employee" },
          class: "form-select" %>
  </div>

  <div class="mb-3">
    <label class="fw-semibold">Work Type</label>
    <%= f.select :work_type,
          [["Work From Office", "wfo"], ["Work From Home", "wfh"], ["No Working", "no-working"]],
          { prompt: "Select Work Type" },
          class: "form-select" %>
  </div>

  <div class="mb-3">
    <label class="fw-semibold">Remarks</label>
    <%= f.text_area :remarks, class: "form-control", rows: 3 %>
  </div>

  <%= f.submit "Save Activity", class: "btn btn-primary" %>
<% end %>
