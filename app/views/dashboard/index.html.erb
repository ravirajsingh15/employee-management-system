<div class="container-fluid">
  <h2 class="mb-4 fw-bold">Dashboard</h2>
  <div class="row g-4">

    <div class="col-md-3 col-sm-6">
      <div class="card dashboard-card text-center p-4">
        <h6>Total Employees</h6>
        <div class="chart-wrapper">
          <canvas id="totalEmployeesTodayChart"></canvas>
          <div class="chart-center"><%= @total_employees %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3 col-sm-6">
      <div class="card dashboard-card text-center p-4">
        <h6>Work From Office</h6>
        <div class="chart-wrapper">
          <canvas id="wfoChart"></canvas>
          <div class="chart-center"><%= @total_wfo %></div>
        </div>
      </div>
    </div>

    <div class="col-md-3 col-sm-6">
      <div class="card dashboard-card text-center p-4">
        <h6>Work From Home</h6>
        <div class="chart-wrapper">
          <canvas id="wfhChart"></canvas>
          <div class="chart-center"><%= @total_wfh %></div>
        </div>
      </div>
    </div>

     <div class="col-md-3 col-sm-6">
      <div class="card dashboard-card text-center p-4">
        <h6>Non Working</h6>
        <div class="chart-wrapper">
          <canvas id="noworkingChart"></canvas>
          <div class="chart-center"><%= @total_noworking %></div>
        </div>
      </div>
    </div>

  </div>
</div>

<style>
.dashboard-card {
  border-radius: 20px;
  background: linear-gradient(145deg, #ffffff, #ececec);
  box-shadow: 8px 8px 20px #cfcfcf, -8px -8px 20px #ffffff;
}

.dashboard-card1 {
  border-radius: 20px;
  background: linear-gradient(145deg, #ffffff, #ececec);
  box-shadow: 8px 8px 20px #cfcfcf, -8px -8px 20px #ffffff;
  width: 50% !important;
}

.chart-wrapper {
  position: relative;
  width: 130px;
  height: 130px;
  margin: auto;
}

.chart-wrapper canvas {
  width: 130px !important;
  height: 130px !important;
}

.chart-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-weight: bold;
  font-size: 22px;
}

.legend-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {

  function donut(id, value, color) {
    new Chart(document.getElementById(id), {
      type: 'doughnut',
      data: {
        datasets: [{
          data: [value, Math.max(1, 100 - value)],
          backgroundColor: [color, '#e9ecef'],
          borderWidth: 0
        }]
      },
      options: {
        cutout: '75%',
        plugins: { legend: { display: false } }
      }
    });
  }

  donut('totalSignupsChart', <%= @total_signups %>, '#0d6efd');
  donut('totalEmployeesTodayChart', <%= @total_employees %>, '#198754');
  donut('wfoChart', <%= @total_wfo %>, '#ffc107');
  donut('wfhChart', <%= @total_wfh %>, '#0dcaf0');
  donut('noworkingChart', <%= @total_noworking %>, "#dc3545");

  new Chart(document.getElementById("workSummaryChart"), {
    type: "doughnut",
    data: {
      labels: ["WFH", "WFO", "No Working"],
      datasets: [{
        data: [
          <%= @total_wfh %>,
          <%= @total_wfo %>,
          <%= @total_noworking %>
        ],
        backgroundColor: ["#0dcaf0", "#ffc107", "#dc3545"],
        borderWidth: 0
      }]
    },
    options: {
      cutout: "70%",
      plugins: { legend: { display: false } }
    }
  });

});
</script>
